@model IEnumerable<DoanThucTapChuyenNganh.Models.Category>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="app-content pt-3 p-md-3 p-lg-4 mt-5">
    <div class="container-xl">

<h1>Danh sách danh mục sản phẩm</h1>

<p>
            <a asp-area="Admin" asp-controller="Category" asp-action="formAddCategory" class="btn btn-primary" >Thêm loại sản phẩm</a>
</p>
        <table class="table  table-hover align-content-center text-center">
            <thead class="table-dark">
        <tr>
                    <th>@Html.DisplayNameFor(modelItem => modelItem.Id)</th>
                     <th>
                        @Html.DisplayNameFor(modelItem => modelItem.Name)
                      </th>
            <th>Tác vụ</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
                        <td class="d-flex gap-3 justify-content-center">
                            <a asp-controller="Category" asp-action="formEditCategories" asp-route-id="@item.Id" as class="text-warning"><i class="fa-solid fa-pen-to-square"></i></a>
                            <a asp-controller="Category" asp-action="formRemoveCategories" asp-route-id="@item.Id" class="text-danger"><i class="fa-solid fa-trash"></i></a>
                        </td>
        </tr>
}
    </tbody>
</table>
</div>
</div>