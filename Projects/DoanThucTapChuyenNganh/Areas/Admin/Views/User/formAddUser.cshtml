@model DoanThucTapChuyenNganh.Areas.Admin.Models.UserViewModel

@{
    ViewData["Title"] = "Thêm người dùng mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="app-content pt-3 p-md-3 p-lg-4 mt-5">
    <div class="container-xl">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h4 class="m-0 font-weight-bold text-primary">Thêm người dùng mới</h4>
            </div>
            <div class="card-body">
                <form asp-action="AddUser" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 border-end">
                            <h5 class="text-muted mb-3">Thông tin đăng nhập</h5>

                            <div class="form-group mb-3">
                                <label asp-for="UserName" class="control-label fw-bold"></label>
                                <input asp-for="UserName" class="form-control" placeholder="Nhập tên đăng nhập..." />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Password" class="control-label fw-bold"></label>
                                <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu..." />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="ConfirmPassword" class="control-label fw-bold"></label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu..." />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label class="control-label fw-bold d-block">Phân quyền</label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" asp-for="IsAdmin" />
                                    <label class="form-check-label" asp-for="IsAdmin"></label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-muted mb-3">Thông tin cá nhân</h5>

                            <div class="form-group mb-3">
                                <label asp-for="FullName" class="control-label fw-bold"></label>
                                <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Email" class="control-label fw-bold"></label>
                                <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="PhoneNumber" class="control-label fw-bold"></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Số điện thoại..." />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Address" class="control-label fw-bold"></label>
                                <input asp-for="Address" class="form-control" placeholder="Địa chỉ..." />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div> 
                           
                        </div>
                    </div>

                    <hr />

                    <div class="form-group text-end">
                        <a asp-action="Index" class="btn btn-secondary me-2">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Lưu người dùng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}