@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />

    <link rel="shortcut icon" href="~/images/Shoplogo.png" type="image/x-icon">
    <title>@ViewData["Title"] - HG Billiards Shop</title>

    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css" integrity="sha512-CruCP+TD3yXzlvvijET8wV5WxxEh5H8P4cmz0RFbKK6FlZ2sYl3AEsKlLPHbniXKSrDdFewhbmBK5skbdsASbQ==" crossorigin="anonymous" />

    <link rel="stylesheet" type="text/css" href="~/css/bootstrap.css" asp-append-version="true" />
    <link href="~/css/font-awesome.min.css" rel="stylesheet" asp-append-version="true" />

    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/responsive.css" rel="stylesheet" asp-append-version="true" />
    <script src="https://kit.fontawesome.com/2a511f8519.js" crossorigin="anonymous"></script>
</head>
<body>

    <div class="container">
        <div class="body d-md-flex align-items-center justify-content-between">
            <div class="box-1 mt-md-0 mt-5">
                <img src="https://images.pexels.com/photos/2033997/pexels-photo-2033997.jpeg?auto=compress&cs=tinysrgb&dpr=2&w=500"
                     class="" alt="">
            </div>
            <div class=" box-2 d-flex flex-column h-100 ">
                <div class="mt-5">
                    <p class="mb-1 h-1">Đăng ký</p>
                    <p class="text-muted mb-2">Vui lòng điền thông tin để đăng ký tài khoản.</p>
                    <div class="d-flex flex-column ">
                        <form>
                            <input class="py-1 w-100 form-check mb-1 custom-rounded-input" type="text" id="username" placeholder="Nhập tên đăng nhập" />
                            <input class="py-1 w-100 form-check mb-1 custom-rounded-input" type="number" id="sodienthoai" placeholder="Nhập số điện thoại" />
                            <input class="py-1 w-100 form-check mb-1 custom-rounded-input" type="email" id="email" placeholder="Nhập email" />
                            <input class="py-1 w-100 form-check mb-1 custom-rounded-input" type="password" id="password" placeholder="Nhập mật khẩu" />
                            <input class="py-1 w-100 form-check mb-2 custom-rounded-input" type="password" id="comfirmpassword" placeholder="Xác nhận mật khẩu" />

                        </form>
                        <a class="btn btn-primary bg-primary py-1 text-white" asp-controller="Admin" asp-action="Index">Đăng ký</a>
                        <div class="d-flex align-items-center">
                        </div>
                        <div class="mt-3  d-flex justify-content-between">
                            <div class="">
                                <a class="mb-0 text-muted" asp-controller="Account" asp-action="Login">Bạn đã có tài khoản? Đăng nhập.</a>

                            </div>
                            
                        </div>
                    </div>
                </div>
              @*  <div class="mt-auto">
                    <p class="footer text-muted mb-0 mt-md-0 mt-4">
                        By register you agree with our
                        <span class="p-color me-1">terms and conditions</span>and
                        <span class="p-color ms-1">privacy policy</span>
                    </p>
                </div>*@
            </div>
            <a class="fas fa-times text-bg-danger mb-2" asp-controller="Home" asp-action="Index"></a>
        </div>
    </div>
</body>
