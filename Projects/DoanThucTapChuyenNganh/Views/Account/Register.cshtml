@using DoanThucTapChuyenNganh.ViewModels
@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - HG Billiards Shop</title>

    <link rel="stylesheet" type="text/css" href="~/css/bootstrap.css" asp-append-version="true" />
    <link href="~/css/font-awesome.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    <script src="https://kit.fontawesome.com/2a511f8519.js" crossorigin="anonymous"></script>
</head>

<body style="background-color: #f8f9fa;" class="d-flex align-items-center min-vh-100">

    <div class="w-100 px-3 py-5">

        <div class="container container-custom p-0 bg-white shadow rounded overflow-hidden mx-auto" style="max-width: 900px;">
            <div class="row m-0 w-100 h-100">

                <div class="col-md-6 p-0 d-none d-md-block box-1">
                    <img src="https://images.pexels.com/photos/2033997/pexels-photo-2033997.jpeg?auto=compress&cs=tinysrgb&dpr=2&w=500"
                         alt="Billiards" class="w-100 h-100" style="object-fit: cover;">
                </div>

                <div class="col-md-6 p-0 position-relative">

                    <a class="fas fa-times text-danger position-absolute"
                       style="top: 15px; right: 20px; font-size: 20px; text-decoration: none; z-index: 10;"
                       asp-controller="Home" asp-action="Index"></a>

                    <div class="register-box p-4">
                        <div class="mb-4">
                            <h3 class="font-weight-bold">Đăng ký</h3>
                            <p class="text-muted" style="font-size: 14px;">Vui lòng điền thông tin để đăng ký tài khoản.</p>
                        </div>

                        <form asp-controller="Account" asp-action="Register" method="post">

                            <div class="input-wrapper mb-3">
                                <input asp-for="Username" class="form-control py-2" placeholder="Tên đăng nhập" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <div class="input-wrapper mb-3">
                                <input asp-for="FullName" class="form-control py-2" placeholder="Họ và tên" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="input-wrapper mb-3">
                                <input asp-for="Email" class="form-control py-2" type="email" placeholder="Email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="input-wrapper mb-3">
                                <input asp-for="Password" class="form-control py-2" type="password" placeholder="Mật khẩu" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="input-wrapper mb-3">
                                <input asp-for="ConfirmPassword" class="form-control py-2" type="password" placeholder="Nhập lại mật khẩu" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <button class="btn btn-primary bg-primary py-2 text-white w-100 mt-2" type="submit">
                                Đăng ký
                            </button>
                        </form>

                        <div class="mt-4 text-center">
                            <span class="text-muted small">Bạn đã có tài khoản? </span>
                            <a class="font-weight-bold text-primary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>