
@{
    ViewData["Title"] = "ForgotPassword";
    Layout = "~/Views/Shared/_SubPageLayout.cshtml";
}

<div class="row">
    <div class="container d-flex  justify-content-center w-25  mt-3 mb-3 rounded">
        <div class="col w-50 app-login ">
            <div class="form_container bg-light border border-primary p-3 ">
                
                <form method="post" action="ResetPassword">

                    <div class="form-detail text-center">
                        <h2 > Quên mật khẩu?</h2>
                        <p>Vui lòng điền gmail để lấy lại mật khẩu </p>
                    </div>

                    <div class="form-check">
                        <label for="Email" class="form-label"> </label>
                        <input type="email" class="form-control" id="Email" name="Email" placeholder="Nhập địa chỉ email" required>
                    </div>

       

                    <div class="text-center mb-3">
                        <button type="submit" class="btn btn-primary m-2 px-5 py-2 fw-semibold">Gửi lại mật khẩu</button>

                    </div>
                    <div class="d-flex gap-4 justify-content-between mt-4">
                        <a asp-controller="Account" asp-action="Login" class="text-primary">
                            Quay trở lại đăng nhập!
                        </a>

                        
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

