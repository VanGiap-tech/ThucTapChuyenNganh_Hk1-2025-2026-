
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_SubPageLayout.cshtml";
}

<div class="row">
    <div class="container d-flex  justify-content-center w-25  mt-3 mb-3">
        <div class="col w-50 app-login">
            <div class="form_container bg-light border border-primary p-3">
                <h2 class="text-center">Đăng nhập tài khoản</h2>
                <form method="post" action="Login">


                    <div class="mb-2">
                        <label for="Email" class="form-label">Tên đăng nhập</label>
                        <input type="text" class="form-control" id="Email" name="Email" placeholder="Nhập địa chỉ email" required>
                    </div>

                    <div class="mb-2">
                        <label for="password" class="form-label">Mật khẩu</label>
                        <input type="password" class="form-control" id="password" name="password" placeholder="Nhập mật khẩu" required>
                    </div>



                    <div class="text-center">
                        <button type="submit" class="btn btn-primary m-2 px-5 py-2 fw-semibold">Đăng nhập</button>

                    </div>
                    <div class="d-flex gap-4 justify-content-between mt-3">
                        <a asp-controller="Account" asp-action="ForgotPassword" class="text-primary">
                            Quên mật khẩu?
                        </a>

                        <a asp-controller="Account" asp-action="Register" class="text-primary mx-1">
                            Đăng ký tài khoản
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
