
@{
    ViewData["Title"] = "Brands";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="app-content pt-3 p-md-3 p-lg-4 mt-5">
    <div class="container-xl">

        <h1>Danh sách nhà sản xuất</h1>

        <p>
            <a asp-action="Create" class="btn btn-primary">Thêm nhà sản xuất</a>
        </p>
        <div class="app-card alert alert-dismissible shadow-sm mb-4 border-left-decoration" role="alert">
            <table class="table table-hover align-content-center text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Mã nhà sản xuất</th>
                        <th>Tên nhà sản xuất</th>
                        <th>Mô tả</th>
                        <th>Hình ảnh</th>
                        <th>Xuất xứ</th>

                        <th>Tác vụ</th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td>1</td>
                        <td>PERI</td>
                        <td>Một thương hiệu đình đám trong làng billiards</td>

                        <td><img src="~/images/brand/Peri.jpg" width="70" class="rounded"></td>

                        <td>Trung quốc</td>
                        <td >
                            <button class="btn  btn-info">Sửa</button>
                            <button class="btn  btn-danger">Xóa</button>
                        </td>
                    </tr>
                   
                </tbody>
            </table>

        </div>
    </div>
</div>
