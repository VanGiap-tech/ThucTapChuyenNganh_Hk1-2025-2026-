@model DoanThucTapChuyenNganh.Models.Brand

@{
    ViewData["Title"] = "formAddBrands";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="app-content pt-3 p-md-3 p-lg-4 mt-5">
    <div class="container-xl">
        <h1>Thêm nhà sản xuất của sản phẩm</h1>


        <hr />
        <div class="row">
            <div class="col-md-4">
                <form asp-action="AddBrands">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label class="control-label">Tên nhà sản xuất</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Xuất xứ</label>
                        <input asp-for="Country" class="form-control" />
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Thêm" class="btn btn-primary mt-2" />
                    </div>
                </form>
            </div>
        </div>

        <div>
            <a asp-controller="Brand" asp-action="Brands">Trở lại danh sách</a>
        </div>


    </div>
</div>
