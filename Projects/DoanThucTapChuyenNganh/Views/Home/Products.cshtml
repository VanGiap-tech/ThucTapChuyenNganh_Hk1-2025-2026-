@model IEnumerable<DoanThucTapChuyenNganh.Models.Product>

@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_SubPageLayout.cshtml";
}

<section class="food_section layout_padding">
    <div class="container">
        <ul class="breadcrumb bg-white text-decoration-underline">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Products</li>
        </ul>

        <div class="heading_container heading_center">
            <h2>Danh sách sản phẩm</h2>
        </div>

        <ul class="filters_menu">
            <li class="active" data-filter="*">All</li>
            @foreach (var cat in ViewBag.Categories)
            {
                
                <li data-filter=".@cat.Name.Replace(" ", "")">@cat.Name</li>
            }
        </ul>

        <div class="filters-content">
            <div class="row grid">
                @foreach (var item in Model)
                {
                    
                    string filterClass = item.Category?.Name?.Replace(" ", "") ?? "Misc";

                    <div class="col-sm-6 col-lg-4 all @filterClass">
                        <div class="box">
                            <div>
                                <div class="img-box">
                                    <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.Id">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="~/images/products/@item.ImageUrl" alt="@item.Name">
                                        }
                                        else
                                        {
                                            <img src="~/images/no-image.png" alt="No Image">
                                        }
                                    </a>
                                </div>

                                <div class="detail-box">
                                    <h5>@item.Name</h5>
                                    <p>@item.Description</p>
                                    <div class="options">
                                        <h6>
                                            @item.Price.ToString("#,##0") VNĐ
                                        </h6>
                                        <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Id">
                                            <svg version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 456.029 456.029" style="enable-background:new 0 0 456.029 456.029;" xml:space="preserve">
                                            <g>
                                            <path d="M345.6,338.862c-29.184,0-53.248,23.552-53.248,53.248c0,29.184,23.552,53.248,53.248,53.248 c29.184,0,53.248-23.552,53.248-53.248C398.336,362.926,374.784,338.862,345.6,338.862z" />
                                            </g>
                                            <g>
                                            <path d="M439.296,84.91c-1.024,0-2.56-0.512-4.096-0.512H112.64l-5.12-34.304C104.448,27.566,84.992,10.67,61.952,10.67H20.48 C9.216,10.67,0,19.886,0,31.15c0,11.264,9.216,20.48,20.48,20.48h41.472c2.56,0,4.608,2.048,5.12,4.608l31.744,216.064 c4.096,27.136,27.648,47.616,55.296,47.616h212.992c26.624,0,49.664-18.944,55.296-45.056l33.28-166.4 C457.728,97.71,450.56,86.958,439.296,84.91z" />
                                            </g>
                                        </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="btn-box">
            <a href="">View More</a>
        </div>
    </div>
</section>