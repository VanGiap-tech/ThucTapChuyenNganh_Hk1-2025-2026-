
@{
    ViewData["Title"] = "Cart";
    Layout = "~/Views/Shared/_SubPageLayout.cshtml";
}

<section class="book_section layout_padding">
    <div class="container">
        <div class="heading_container heading_center">
            <h1 >
                Giỏ hàng của bạn
            </h1>
        </div>
        <div class="row justify-content-center ">

            <div class="app-card alert alert-dismissible shadow-sm mb-4 border-left-decoration w-100" role="alert">
                    <table class="table table-hover align-content-center text-center">
                        <thead class="table-dark">
                            <tr>
                                <th>Hình ảnh</th>
                               
                                <th>Tên sản phẩm</th>
                                
                                <th>Giá</th>
                                
                                <th>Số lượng</th>
                                <th>Trọng lượng</th>
                                <th>Xóa</th>
                             
                                
                            </tr>
                        </thead>
                        <tbody>

                            <tr>
                                <td><img src="~/images/cue/cue-ls-en02-male-phoenix-700x700.jpg" width="70" class="rounded"></td>
                                <td>Cơ LS-EN02</td>
                               
                                <td>$550</td>
                                <td><input type="number" value="1" class="w-25 rounded" /></td>
                                <td>19<span>oz</span></td>
                                <td><a href="#"><i class="fa-solid fa-trash text-danger"></i></a></td>
                               
                            </tr>
                     

                        </tbody>
                    </table>

               

            </div>
           
        </div>
        <div class="row  justify-content-center">
            <div class=""> 
                <div class="d-flex justify-content-between mt-2 gap-2">
                    Bạn có voucher?  
                    <input class="border rounded-2" type="text" />
                </div>
                
                <div class="d-flex justify-content-between mt-2">
                    <p><strong>Tổng số lượng :</strong></p>
                    <span>1</span>
                </div>
               <div class="d-flex justify-content-between mt-2">
                    <p><strong>Tổng tiền :</strong></p>
                    <span>$550</span>
               </div>
               <form class="mt-2">
                   <button class="btn btn-primary px-5 py-2 w-100">Thanh toán</button>
               </form>
            </div>
        </div>
    </div>
</section>