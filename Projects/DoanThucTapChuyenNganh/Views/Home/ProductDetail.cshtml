
@{
    ViewData["Title"] = "ProductDetail";
    Layout = "~/Views/Shared/_SubPageLayout.cshtml";
}

<section class="about_section layout_padding">
    <div class="container">

        <div class="row">
            
            <div class="col-md-6">
                <div class="img-box">
                    <img src="~/images/cue/cue-ls-en02-male-phoenix-700x700.jpg" alt="Cơ HG LS-EN02 Male Phoenix">
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-box">
                    <div class="heading_container">
                        <h2>
                            Cơ HG LS-EN02 Male Phoenix
                        </h2>
                    </div>
                    <p>
                        <strong>HG LS-EN02 Male Phoenix</strong> – cơ bida cao cấp, thiết kế tinh xảo, mang đến trải nghiệm chơi mượt mà và chính xác.
                    </p>

                    <div class="purchase-section mb-4">
                        <label for="quantity">Số lượng:</label>
                        <input  type="number" id="quantity" name="quantity" value="1" min="1" class="form-control w-auto d-inline-block ms-2">
                        <button class="btn btn-outline-primary">Thêm vào giỏ hàng</button>
                    </div>

                 
                    <div class="specifications mt-4">
                        <h5>Thông số kỹ thuật:</h5>
                        <ul>
                            <li>Chiều dài: 147 cm</li>
                            <li>Trọng lượng: 19 oz</li>
                            <li>Chất liệu: Gỗ Maple chọn lọc, mối nối carbon cứng cáp</li>
                            <li>Đầu cơ: 13 mm cao su mềm, chống mài mòn</li>
                            <li>Thiết kế: Họa tiết Phoenix độc quyền, sơn bóng cao cấp</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>