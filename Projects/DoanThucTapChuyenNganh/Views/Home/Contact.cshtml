
@{
    ViewData["Title"] = "Contact";
    Layout = "~/Views/Shared/_SubPageLayout.cshtml";
}


<section class=" layout_padding ">
    <div class="container">

        <div class="row justify-content-center mb-5">
            <div class="heading_container heading_center ">
                <h1>Hãy để lại thông tin để HG Shop liên hệ nhé!</h1>
                <p class="text-muted mt-2">
                    Chúng tôi luôn sẵn sàng hỗ trợ bạn — kết nối qua mạng xã hội hoặc gửi thông tin trực tiếp cho bộ phận CSKH.
                </p>
            </div>
        </div>

     

        
        <div class="row justify-content-center mb-5">
            <div class="col-md-6">
                <div class="form_container bg-light  p-4 rounded shadow-sm">
                    <form method="post" asp-action="Contact">
                        <div class="mb-3">
                            <label for="Name" class="form-label">Họ và tên</label>
                            <input type="text" class="form-control" id="Name" name="Name" placeholder="Nhập họ và tên của bạn" required>
                        </div>

                        <div class="mb-3">
                            <label for="Email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="Email" name="Email" placeholder="Nhập địa chỉ email" required>
                        </div>

                        <div class="mb-3">
                            <label for="Phone" class="form-label">Số điện thoại</label>
                            <input type="tel" class="form-control" id="Phone" name="Phone" placeholder="Nhập số điện thoại">
                        </div>

                        <div class="mb-3">
                            <label for="Message" class="form-label">Nội dung</label>
                            <textarea class="form-control" id="Message" name="Message" rows="4" placeholder="Nhập nội dung bạn muốn gửi..." required></textarea>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary px-4">Gửi liên hệ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="row justify-content-center text-center mb-5">
            <div class="col-md-6">
                <h3 class="heading_container heading_center  mb-3">Kết nối với chúng tôi</h3>
                <div class="social-icons">
                    <a href="https://www.facebook.com/" class="mx-3 text-decoration-none text-primary" target="_blank">
                        <img src="~/images/icon/face.png" alt="Facebook">
                    </a>
                    <a href="https://www.tiktok.com/" class="mx-3 text-decoration-none text-dark" target="_blank">
                        <img src="~/images/icon/titktok.png" alt="Tiktok">
                    </a>
                    <a href="https://zalo.me/" class="mx-3 text-decoration-none text-info" target="_blank">
                        <img src="~/images/icon/7044033_zalo_icon.png" alt="Zalo">
                    </a>
                </div>
            </div>
        </div>
        
            
                <h3 class="heading_container heading_center  mb-3">Đường đi tới HG SHOP</h3>
                <div class="map_container">
                    <iframe  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d244.9885679295204!2d106.69982392382299!3d10.748576268169801!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f1b953993c3%3A0x436ad5ecb51824f6!2zTOG7m3AgTeG6p20gbm9uIE5nw7RpIE5ow6AgQ-G7p2EgQsOp!5e0!3m2!1svi!2s!4v1762968953417!5m2!1svi!2s" width="100%" height="500px" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>

              
       
    </div>
</section>
